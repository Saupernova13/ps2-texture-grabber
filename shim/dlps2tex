#!/bin/sh
# ===========================================================================
#  dlps2tex - friendly launcher for the ps2tex binary (Linux / Steam Deck).
#  The Windows equivalent is dlps2tex.cmd beside this file. Put both this and
#  ps2tex in one folder and add that folder to PATH.
#
#  A bare first argument is treated as the query, so `dlps2tex "God of War"`
#  works without spelling out --query - as does a serial, which is what dlrom
#  hands off. Anything starting with '-' is passed through untouched, so
#  `dlps2tex --search "God of War"` and `dlps2tex --browse` work as-is.
#
#  See README.md for the full command list.
# ===========================================================================

set -eu

# Resolve symlinks first: a launcher linked into ~/.local/bin would otherwise resolve
# `dirname $0` to the link's directory, where the ps2tex binary does not live.
SELF=$0
while [ -L "$SELF" ]; do
    link=$(readlink -- "$SELF")
    case $link in
        /*) SELF=$link ;;
        *)  SELF=$(dirname -- "$SELF")/$link ;;
    esac
done
SHIM_DIR=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)

# Beside this shim, then the repo's publish output, then PATH.
PS2TEX=""
for candidate in "$SHIM_DIR/ps2tex" "$SHIM_DIR/../bin/publish/ps2tex"; do
    if [ -x "$candidate" ]; then PS2TEX=$candidate; break; fi
done
[ -n "$PS2TEX" ] || PS2TEX=$(command -v ps2tex 2>/dev/null || true)

if [ -z "$PS2TEX" ]; then
    echo "[ERROR] ps2tex binary not found." >&2
    echo "Looked beside this script, in ../bin/publish, and on PATH." >&2
    echo "Build it with:" >&2
    echo "  dotnet publish -c Release -r linux-x64 --self-contained true -p:PublishSingleFile=true -o bin/publish" >&2
    exit 1
fi

if [ $# -eq 0 ]; then
    exec "$PS2TEX"
fi

# Promote a bare first argument to --query; leave every flag alone.
case "$1" in
    -*) exec "$PS2TEX" "$@" ;;
    *)
        query=$1
        shift
        exec "$PS2TEX" --query "$query" "$@"
        ;;
esac
