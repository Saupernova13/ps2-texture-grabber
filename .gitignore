# ---------------------------------------------------------------------------
# Build output
#
# Nothing under bin/ or obj/ belongs in git. This repo used to track
# bin/publish/ps2tex.exe (plus its .pdb and playwright.ps1) so the launcher had
# something to point at; releases carry the binary now, and CI rebuilds it from
# source on every push.
# ---------------------------------------------------------------------------
bin/
obj/

# Leftover build directory from the old csharp/ project layout. The sources live
# at the repo root; nothing in here is compiled (see the csproj's Compile Remove).
csharp/

# ---------------------------------------------------------------------------
# Runtime data
#
# data/ is created next to the exe at startup (AppPaths.EnsureAll) and holds the
# caches and job state. `ps2tex --clean` is the supported way to empty it.
# ---------------------------------------------------------------------------
data/

# User-local configuration. .settings.example is committed; .settings is not -
# it holds absolute paths into the user's own profile.
.settings

# Logs
*.log

# Release staging, produced by the release workflow and by scripts/pack.ps1
dist/

# ---------------------------------------------------------------------------
# Tooling / OS / editors
# ---------------------------------------------------------------------------
.vs/
*.user
*.suo
*.userprefs
.vscode/
.idea/
*.swp

Thumbs.db
desktop.ini
.DS_Store
